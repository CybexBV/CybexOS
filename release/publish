#!/usr/bin/env bash
# Publish a Cybex OS release: tag the checked commit and create its GitHub
# release. The GitHub repository is the trust root; there is no signing step.
# Installed machines take the newest release on their channel.
#
# Run it from the release-VERSION branch the full check passed, or from main.
# A release branch is merged into main afterwards (git merge --no-ff), so work
# that landed on main during the check waits for the next release instead of
# forcing another check.
#
#   release/publish VERSION [--stable] [--dry-run] [ASSET...]
#
# A release goes to the beta channel first: it is published as a GitHub
# prerelease, which only beta machines install. Once it has proven itself,
# release/promote moves that same release (same tag, commit and content) to
# stable. --stable publishes straight to both channels, for an urgent fix or
# when no beta is wanted; a prerelease version (1.2.3-beta.1) is beta only.
#
# VERSION must equal the committed VERSION file. release/notes.md is the
# release text. Optional assets (an ISO, its checksum) are uploaded with it.
# The commit must have passed the full check (nixos.yml) first. --stable also
# needs what release/promote checks before stable: every machine on the
# current stable release must be able to install it.
#
# A publish that failed after pushing its tag is finished by running it again
# from the same commit: the tag is kept and the release is created, or the
# draft gh left behind is completed. A tag that names another commit, or a
# release that is already published, is never reused.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
REPO=${CYBEXOS_RELEASE_REPO:-CybexBV/CybexOS}

fail() { echo "release/publish: $*" >&2; exit 1; }

version=${1:-}
[[ -n $version && $version != -* ]] || fail 'usage: release/publish VERSION [--stable] [--dry-run] [ASSET...]'
shift
dry_run=0 stable=0
while [[ ${1:-} == --* ]]; do
    case $1 in
        --dry-run) dry_run=1 ;;
        --stable) stable=1 ;;
        *) fail "unknown option $1" ;;
    esac
    shift
done
assets=("$@")

[[ $version =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-(beta|rc)\.[1-9][0-9]*)?$ ]] \
    || fail "$version is not a semantic release version (1.2.3 or 1.2.3-beta.1)"
[[ $(<VERSION) == "$version" ]] || fail "VERSION is $(<VERSION), not $version; commit the version first"
if ((stable)) && [[ $version == *-* ]]; then
    fail "$version is a prerelease version; it can only reach the beta channel"
fi
python3 -c 'import json, sys; c = json.load(open("release/compatibility.json")); sys.exit(c.get("schema") != 1)' \
    || fail 'release/compatibility.json is missing or invalid'
[[ -s release/notes.md ]] || fail 'release/notes.md is empty'
for asset in "${assets[@]}"; do
    [[ -f $asset ]] || fail "asset $asset does not exist"
done
[[ -z $(git status --porcelain) ]] || fail 'commit or stash local changes first'
branch=$(git rev-parse --abbrev-ref HEAD)
[[ $branch == main || $branch == "release-$version" ]] || fail "publish from release-$version or main"
git fetch --quiet origin "$branch" || fail "cannot fetch $branch from origin; push it first"
[[ $(git rev-parse HEAD) == "$(git rev-parse FETCH_HEAD)" ]] \
    || fail "$branch must equal origin/$branch; push or pull first"

tag=v$version
revision=$(git rev-parse HEAD)
# A tag that names another commit belongs to another release. One that names
# this commit is this publish's own, pushed before gh failed: it resumes.
remote=$(git ls-remote origin "refs/tags/$tag" "refs/tags/$tag^{}") || fail 'cannot read the tags on origin'
tagged=$(awk -v ref="refs/tags/$tag" '$2 == ref "^{}" { peeled = $1 } $2 == ref { plain = $1 }
    END { print peeled != "" ? peeled : plain }' <<<"$remote")
local_tag=$(git rev-parse --quiet --verify "refs/tags/$tag^{commit}" || true)
for commit in "$tagged" "$local_tag"; do
    if [[ -n $commit && $commit != "$revision" ]]; then
        fail "$tag already exists at ${commit:0:12}, not at $revision; a published version is never reused"
    fi
done
# GitHub's prerelease flag is what keeps a release off the stable channel.
kind=(--prerelease --latest=false) channel=beta
# --prerelease=false too: resuming a draft that gh left as a prerelease.
if ((stable)); then kind=(--prerelease=false --latest) channel='stable and beta'; fi
# Only a commit the full check passed reaches machines: every job of a
# nixos.yml run on The Beast, dispatched or started by the push to main
# (docs/releasing.md#the-full-check). Both check out exactly this commit; a
# pull request's run checks a merge commit instead, so it doesn't count. A
# run whose upgrade job started from another release (`-f from=`) has its
# own title and doesn't count either.
qualified=$(gh run list --repo "$REPO" --workflow nixos.yml --commit "$revision" --status success --limit 100 \
    --json event,displayTitle --jq '[.[] | select((.event == "workflow_dispatch" or .event == "push") and .displayTitle == "NixOS qualification")] | length') \
    || fail 'cannot ask GitHub whether the full check passed; nothing was published'
[[ $qualified =~ ^[1-9][0-9]*$ ]] || fail "the full check has not passed for $revision; run gh workflow run nixos.yml --repo $REPO --ref main and publish once it passes"
# A run passes only when every job of the commit's own workflow passed. After
# 1.0.32 that workflow must include the upgrade job (docs/releasing.md#the-upgrade-job).
if python3 -c 'import sys; sys.path.insert(0, "lifecycle"); from cybexos.trust import version; sys.exit(version(sys.argv[1]) <= version("1.0.32"))' "$version"; then
    grep -Eq '^  upgrade:' .github/workflows/nixos.yml \
        || fail 'the full check of this commit has no upgrade job; a release after 1.0.32 needs one'
fi
# Every release keeps each NixOS branch the newest published one lists: a
# machine that installed a release alone keeps its branch, and a beta that
# dropped it would refuse that machine. With --stable, also the check
# release/promote makes before a release reaches stable. Only the tags it
# compares with are fetched.
problems=$(python3 -c '
import importlib.machinery, importlib.util, json, sys
loader = importlib.machinery.SourceFileLoader("promote", "release/promote")
promote = importlib.util.module_from_spec(importlib.util.spec_from_loader("promote", loader))
loader.exec_module(promote)
candidate, stable, wanted_version = sys.argv[1], sys.argv[2] == "1", promote.version(sys.argv[3])
listing = promote.releases()
newest = max(listing, key=lambda item: item["key"], default=None)
if newest and wanted_version <= newest["key"]:
    print("it is not newer than " + newest["tag_name"] + ", which machines already have; take the next version")
    sys.exit()
current = max((item for item in listing if promote.stable(item)), key=lambda item: item["key"], default=None)
for item in {newest["tag_name"] if newest else None, current["tag_name"] if current and stable else None} - {None}:
    promote.run("git", "fetch", "--quiet", "origin", "refs/tags/" + item + ":refs/tags/" + item)
if newest:
    wanted = set(json.loads(promote.source(candidate, "release/compatibility.json")).get("nixos", []))
    have = set(json.loads(promote.source(newest["tag_name"], "release/compatibility.json")).get("nixos", []))
    if have - wanted:
        print("it drops NixOS " + ", ".join(sorted(have - wanted)) + ", which " + newest["tag_name"]
              + " supports and machines that installed a release alone may still run")
        sys.exit()
problems = promote.compatible(candidate, current["tag_name"]) if stable and current else []
if problems:
    print("stable machines on " + current["tag_name"] + " cannot install it: " + "; ".join(problems))
' "$revision" "$stable" "$version") || fail 'cannot check what machines can install; nothing was published'
[[ -z $problems ]] || fail "$problems"
drafts=0
if [[ -n $tagged ]]; then
    # Machines never see a draft; gh leaves one when an upload is interrupted.
    states=$(gh api --paginate "repos/$REPO/releases?per_page=100" --jq ".[] | select(.tag_name == \"$tag\") | .draft") \
        || fail "cannot ask GitHub whether $tag is published"
    if grep -qx false <<<"$states"; then
        fail "$tag is already published; a published version is never reused"
    fi
    drafts=$(grep -cx true <<<"$states" || true)
    ((drafts <= 1)) || fail "GitHub has $drafts draft releases for $tag; delete all but one and run again"
fi
action=publish
[[ -z $tagged ]] || action='finish publishing'
if ((dry_run)); then
    echo "Would $action $tag at $revision to $REPO for $channel (${kind[*]}) with ${#assets[@]} asset(s)."
    exit 0
fi
if [[ -z $tagged ]]; then
    [[ -n $local_tag ]] || git tag --annotate "$tag" --message "Cybex OS $version" "$revision"
    git push --quiet origin "refs/tags/$tag"
else
    echo "Resuming: $tag already names $revision on origin."
fi
if ((drafts)); then
    if ((${#assets[@]})); then
        gh release upload "$tag" --repo "$REPO" --clobber "${assets[@]}"
    fi
    gh release edit "$tag" --repo "$REPO" --draft=false --title "Cybex OS $version" \
        --notes-file release/notes.md "${kind[@]}"
else
    gh release create "$tag" --repo "$REPO" --verify-tag --title "Cybex OS $version" \
        --notes-file release/notes.md "${kind[@]}" "${assets[@]}"
fi
echo "Published $tag at $revision to $REPO for $channel."
if [[ $branch != main ]]; then
    echo "Now merge it into main: git switch main && git pull && git merge --no-ff $branch && git push origin main"
fi
if ! ((stable)) && [[ $version != *-* ]]; then
    echo "Move it to stable once it has proven itself: release/promote $version"
fi
