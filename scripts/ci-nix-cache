#!/usr/bin/env python3
"""The full check's Nix cache on the runners' persistent volumes (.github/workflows/nixos.yml).

Each slot of the CybexOS runner lane on The Beast (github-runners lane
`cybexos`) has a volume of its own at /cache (cache_gib), and the lane can give
every slot one volume they all share at /shared-cache (shared_cache_gib;
switched off again on 2026-11-27, see docs/releasing.md). This keeps a
file:// Nix binary cache on the shared volume when it is mounted, else on the
slot's own, so a job substitutes what an earlier job built instead of building
it again: Cybex OS's own packages, kernel modules, the previous release's ISO
(built by the previous release's image job, needed by this one's upgrade
job), and checks that passed with the same inputs.

  ci-nix-cache prepare   before Nix is installed: create the cache, or start
                         it again empty when its volume is nearly full, and
                         tell later steps where it is (CI_NIX_CACHE and
                         CI_NIX_SUBSTITUTER in $GITHUB_ENV)
  ci-nix-cache save      after the builds: copy every path this runner built
                         (and what it references) into the cache

Several jobs use the shared cache at once. A file:// cache writes each file
under a temporary name and renames it into place, so they can add to it side
by side; a full cache is renamed away before it is deleted, so a job that
starts meanwhile finds an empty cache, not a half-deleted one. Without a
persistent volume (neither is a mount point) both actions are no-ops apart
from an empty directory, so the workflow also runs on a runner without one.
A cache that can't be prepared never fails the job: it runs without it.
"""
import argparse
import json
import os
from pathlib import Path
import secrets
import shutil
import subprocess
import sys

SHARED = Path('/shared-cache')  # the lane's volume, on every slot
SLOT = Path('/cache')           # this slot's own volume
# Above this share of the volume in use, the cache starts again empty. A
# file:// cache has no garbage collector; a cold run refills it.
FULL_PERCENT = 70


def persistent(volume):
    return os.path.ismount(volume)


def sudo(*command, check=True):
    prefix = [] if os.geteuid() == 0 else ['sudo', '-n']
    return subprocess.run([*prefix, *command], check=check)


def percent_used(volume):
    usage = shutil.disk_usage(volume)
    return usage.used * 100 // max(usage.total, 1)


def location(shared=SHARED, slot=SLOT):
    """The volume and the cache directory: the shared volume when it is
    mounted, else the slot's own (which may be just a directory)."""
    return (shared, shared / 'nix') if persistent(shared) else (slot, slot / 'nix')


def copy_url(cache):
    return f'file://{cache}?compression=zstd&parallel-compression=true'


def substituter(cache):
    return f'file://{cache}?trusted=true&priority=10'


def create(cache):
    # Owned by root: the Nix daemon reads it as root.
    sudo('install', '-d', '-m', '755', str(cache), str(cache / 'nar'), str(cache / 'realisations'))


def start_again_if_full(volume, cache, full_percent):
    percent = percent_used(volume)
    if percent < full_percent or not cache.exists():
        print(f'{volume} is {percent}% full.')
        return
    print(f'{volume} is {percent}% full: clearing the Nix cache; this run starts cold.')
    retired = volume / f'{cache.name}.old-{secrets.token_hex(4)}'
    # Another job may have renamed it a moment ago; either way it is gone.
    sudo('mv', '-T', str(cache), str(retired), check=False)


def remove_retired(volume, cache):
    """Delete caches an earlier wipe renamed away (this one's, or one a job
    was stopped in the middle of deleting)."""
    for old in sorted(volume.glob(f'{cache.name}.old-*')):
        sudo('rm', '-rf', '--one-file-system', str(old), check=False)


def announce(cache, env_file):
    lines = f'CI_NIX_CACHE={cache}\nCI_NIX_SUBSTITUTER={substituter(cache)}\n'
    if env_file:
        with open(env_file, 'a') as handle:
            handle.write(lines)
    print(lines, end='')


def prepare(shared=SHARED, slot=SLOT, full_percent=FULL_PERCENT, env_file=None):
    if persistent(shared):
        cache = shared / 'nix'
        try:
            start_again_if_full(shared, cache, full_percent)
            create(cache)
            remove_retired(shared, cache)
        except (OSError, subprocess.CalledProcessError) as error:
            print(f'::warning title=Shared Nix cache unavailable::{shared}: {error}; using this slot\'s own cache.')
        else:
            # The slot's own cache is no longer read: give its space back.
            if persistent(slot) and (slot / 'nix').exists():
                sudo('rm', '-rf', '--one-file-system', str(slot / 'nix'), check=False)
            announce(cache, env_file)
            return 0
    cache = slot / 'nix'
    if persistent(slot):
        start_again_if_full(slot, cache, full_percent)
        remove_retired(slot, cache)
    else:
        print(f'{slot} is not a persistent volume: nothing is kept after this job.')
    create(cache)
    announce(cache, env_file)
    return 0


def built_paths(listing):
    """Store paths this machine built itself ("ultimate"), from
    `nix path-info --all --json` in either of its formats, without
    derivations (evaluation writes those again)."""
    data = json.loads(listing)
    entries = data.items() if isinstance(data, dict) else ((item.get('path'), item) for item in data)
    return sorted(path for path, info in entries
                  if path and isinstance(info, dict) and info.get('ultimate') and not path.endswith('.drv'))


def save(cache=None, shared=SHARED, slot=SLOT):
    """Copy what this runner built into the cache prepare chose (CI_NIX_CACHE)."""
    cache = Path(cache) if cache else location(shared, slot)[1]
    volume = cache.parent
    if not persistent(volume):
        print(f'{volume} is not a persistent volume: nothing to keep.')
        return 0
    nix = shutil.which('nix') or '/nix/var/nix/profiles/default/bin/nix'
    listing = subprocess.run([nix, 'path-info', '--all', '--json'], check=True, capture_output=True,
                             text=True).stdout
    paths = built_paths(listing)
    if not paths:
        print('Nothing was built on this runner.')
        return 0
    print(f'Keeping {len(paths)} built paths and what they reference in {cache}.')
    # As root: the cache is root's, like the daemon that reads it. Paths
    # already in the cache are skipped.
    prefix = [] if os.geteuid() == 0 else ['sudo', '-n']
    result = subprocess.run([*prefix, nix, 'copy', '--to', copy_url(cache), '--stdin'],
                            input='\n'.join(paths) + '\n', text=True)
    if result.returncode:
        print('Could not keep everything; the next run builds the rest again.', file=sys.stderr)
    print(f'{volume}: {percent_used(volume)}% in use.')
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('action', choices=('prepare', 'save'))
    args = parser.parse_args(argv)
    if args.action == 'prepare':
        return prepare(env_file=os.environ.get('GITHUB_ENV'))
    return save(os.environ.get('CI_NIX_CACHE'))


if __name__ == '__main__':
    sys.exit(main())
