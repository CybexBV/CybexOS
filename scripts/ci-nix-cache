#!/usr/bin/env python3
"""The full check's Nix cache on the runner's own disk (.github/workflows/nixos.yml).

Each CybexOS runner slot on The Beast keeps a persistent volume at /cache
(github-runners lane `cybexos`, cache_gib). This keeps a file:// Nix binary
cache there, so a run substitutes what an earlier run on that slot built
instead of building it again: Cybex OS's own packages, kernel modules, the
previous release's ISO, and checks that passed with the same inputs.

  ci-nix-cache prepare   before Nix is installed: create the cache, or clear
                         it when the volume is nearly full
  ci-nix-cache save      after the builds: copy every path this runner built
                         (and what it references) into the cache

Nix reads the cache through `extra-substituters` in the workflow. Without a
persistent volume (/cache not a mount point) both are no-ops apart from an
empty directory, so the workflow also runs on a runner without one.
"""
import argparse
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys

VOLUME = Path('/cache')
CACHE = VOLUME / 'nix'
URL = f'file://{CACHE}?compression=zstd&parallel-compression=true'
# Above this share of the volume in use, the cache starts again empty. A
# file:// cache has no garbage collector; a cold run refills it.
FULL_PERCENT = 70


def persistent(volume=VOLUME):
    return os.path.ismount(volume)


def sudo(*command):
    prefix = [] if os.geteuid() == 0 else ['sudo', '-n']
    subprocess.run([*prefix, *command], check=True)


def prepare(volume=VOLUME, cache=CACHE, full_percent=FULL_PERCENT):
    """Create the cache owned by root (the Nix daemon reads it as root), and
    clear it when the volume is nearly full."""
    if persistent(volume):
        usage = shutil.disk_usage(volume)
        percent = usage.used * 100 // max(usage.total, 1)
        if percent >= full_percent and cache.exists():
            print(f'{volume} is {percent}% full: clearing the Nix cache; this run starts cold.')
            sudo('rm', '-rf', '--one-file-system', str(cache))
        else:
            print(f'{volume} is {percent}% full.')
    else:
        print(f'{volume} is not a persistent volume: nothing is kept after this job.')
    sudo('install', '-d', '-m', '755', str(cache), str(cache / 'nar'), str(cache / 'realisations'))
    return 0


def built_paths(listing):
    """Store paths this machine built itself ("ultimate"), from
    `nix path-info --all --json` in either of its formats, without
    derivations (evaluation writes those again)."""
    data = json.loads(listing)
    entries = data.items() if isinstance(data, dict) else ((item.get('path'), item) for item in data)
    return sorted(path for path, info in entries
                  if path and isinstance(info, dict) and info.get('ultimate') and not path.endswith('.drv'))


def save(volume=VOLUME, url=URL):
    if not persistent(volume):
        print(f'{volume} is not a persistent volume: nothing to keep.')
        return 0
    nix = shutil.which('nix') or '/nix/var/nix/profiles/default/bin/nix'
    listing = subprocess.run([nix, 'path-info', '--all', '--json'], check=True, capture_output=True,
                             text=True).stdout
    paths = built_paths(listing)
    if not paths:
        print('Nothing was built on this runner.')
        return 0
    print(f'Keeping {len(paths)} built paths and what they reference in {CACHE}.')
    # As root: the cache is root's, like the daemon that reads it. Paths
    # already in the cache are skipped.
    prefix = [] if os.geteuid() == 0 else ['sudo', '-n']
    result = subprocess.run([*prefix, nix, 'copy', '--to', url, '--stdin'], input='\n'.join(paths) + '\n',
                            text=True)
    if result.returncode:
        print('Could not keep everything; the next run builds the rest again.', file=sys.stderr)
    usage = shutil.disk_usage(volume)
    print(f'{volume}: {usage.used * 100 // max(usage.total, 1)}% in use.')
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('action', choices=('prepare', 'save'))
    args = parser.parse_args(argv)
    return prepare() if args.action == 'prepare' else save()


if __name__ == '__main__':
    sys.exit(main())
