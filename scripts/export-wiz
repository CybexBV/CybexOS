#!/usr/bin/env node
// Rebuild Wiz's pictures from the rig in desktop/quickshell/Common/WizRig.js
// (docs/assistant.md):
//
//   desktop/quickshell/assets/wiz/<layer>.svg   the layers the shell moves
//   assets/wiz/<pose>.svg                        each pose at rest, in Cybex blue,
//                                                for the terminal and notifications
//   installer/kiosk/assets/wiz/<pose>-<part>.svg the poses the installer shows,
//                                                in the parts it moves
//
//   scripts/export-wiz           write every picture, removing stale ones
//   scripts/export-wiz --check   exit 1 when a committed picture differs
//
// The shell draws each layer once at its final size and only moves it, so a
// change to Wiz's artwork is a change to the rig followed by this export.
"use strict";
const fs = require("node:fs");
const path = require("node:path");

const root = path.resolve(__dirname, "..");
const WizRig = require(path.join(root, "desktop/quickshell/Common/WizRig.js"));

// ---- the installer ------------------------------------------------------------
// The installer kiosk (installer/kiosk/ui/wiz.slint) draws with Slint's
// software renderer, which moves, fades and swaps pictures but neither rotates
// nor scales them. Each pose it shows is three pictures in place: his body
// (shadow, boots, cloak, arms, cape, what he holds and his hands), his eyes
// with their lids (again half and fully closed, for a blink) and his hat. The
// pose's moving parts are cut out apart, placed where they move in that pose.
// Every picture is cropped to what it draws, so a blink, a rune or a bubble
// repaints only a little.
//
//   thinking     checking: runes circle the hat, the star twinkles
//   brewing      installing: he stirs the cauldron, bubbles rise, the star twinkles
//   needs-input  your move: the amber star pulses
//   happy        all good; with sparkles, a finished installation
//   sorry        it failed: the red star
const KIOSK_POSES = ["thinking", "brewing", "needs-input", "happy", "sorry"];
const BODY = ["shadow", "leg", "boot", "body", "glow", "underlight", "sleeve", "cuff", "cape", "pot", "bubble", "book", "orb",
    "orb-swirl", "orb-shine", "scroll", "scroll-line", "wand", "wand-tip", "quill", "finger", "hand", "wisp", "zzz"];
const EYES = ["eyes", "lids"];
const HAT = ["brim", "cone", "thread", "star"];
// Where the star moves, its light lies over a dim star in the hat's picture:
// it twinkles while he works and pulses for a question.
const STAR_APART = ["thinking", "brewing", "needs-input"];
// Brewing: the drawn steps of one turn of the stir, and how far his hand and
// wand go (the rig's act "stir": 3.4 and 1.1 units, 9 degrees).
const STIR = { steps: 12, rx: 3.4, ry: 1.1, wandA: 9 };
// The bubbles on the brew: each one's place and radius in the cauldron's own
// units, as Rig.prototype.ops draws them at the start of their rise.
const BUBBLES = [0, 1, 2, 3, 4].map(b => ({ x: -6 + b * 3, y: -5, r: 0.8 + 1.1 * Math.abs(Math.sin(b * 1.7)) }));

// The matrix m followed by one of toSVG's transforms.
function then(m, step) {
    let n;
    if (step[0] === "t") n = [1, 0, 0, 1, step[1], step[2]];
    else if (step[0] === "s") n = [step[1], 0, 0, step[2], 0, 0];
    else {
        const a = step[1] * Math.PI / 180, cos = Math.cos(a), sin = Math.sin(a), x = step[2], y = step[3];
        n = [cos, sin, -sin, cos, x - cos * x + sin * y, y - sin * x - cos * y];
    }
    return [m[0] * n[0] + m[2] * n[1], m[1] * n[0] + m[3] * n[1], m[0] * n[2] + m[2] * n[3],
        m[1] * n[2] + m[3] * n[3], m[0] * n[4] + m[2] * n[5] + m[4], m[1] * n[4] + m[3] * n[5] + m[5]];
}

// Calls visit(op, map) for each drawing op, map taking its points to the still's frame.
function walk(ops, visit) {
    const stack = [[1, 0, 0, 1, 0, 0]];
    for (const op of ops) {
        if (op.k === "g") stack.push(op.t.reduce(then, stack[stack.length - 1]));
        else if (op.k === "end") stack.pop();
        else {
            const m = stack[stack.length - 1];
            visit(op, (x, y) => [m[0] * x + m[2] * y + m[4], m[1] * x + m[3] * y + m[5]]);
        }
    }
}

// Where `point`, in the frame `layer` is drawn in, lands in the still.
function placed(ops, layer, point) {
    let found = null;
    walk(ops, (op, map) => { if (!found && op.layer === layer) found = map(point[0], point[1]); });
    if (!found) throw new Error(`the pose draws no ${layer}`);
    return found;
}

// A test of ops: a list of layers, or a function of the op.
function chooser(keep) {
    return Array.isArray(keep) ? op => keep.includes(op.layer) : keep;
}

// The ops of the hand on the picture's right, the one he stirs with.
function rightHand(ops) {
    const right = new Set();
    walk(ops, (op, map) => { if (op.layer === "hand" && map(0, 0)[0] > WizRig.LAYOUT.ground[0]) right.add(op); });
    return right;
}

// The corner and control points of what `keep` picks, in the still's frame.
function points(ops, keep) {
    const found = [];
    keep = chooser(keep);
    walk(ops, (op, map) => {
        if (!keep(op)) return;
        const own = op.k === "radial"
            ? [[op.cx - op.r, op.cy - op.r * op.sy], [op.cx + op.r, op.cy + op.r * op.sy],
                [op.cx - op.r, op.cy + op.r * op.sy], [op.cx + op.r, op.cy - op.r * op.sy]]
            : op.d.flatMap(segment => segment.slice(1).flatMap((v, i, all) => i % 2 ? [] : [[v, all[i + 1]]]));
        found.push(...own.map(p => map(p[0], p[1])));
    });
    if (!found.length) throw new Error("the pose does not draw that");
    const xs = found.map(p => p[0]), ys = found.map(p => p[1]);
    return [Math.min(...xs), Math.min(...ys), Math.max(...xs), Math.max(...ys)];
}

// The whole units around the drawing of `keep`, `margin` wider on each side.
function bounds(ops, keep, margin) {
    const [x0, y0, x1, y1] = points(ops, keep);
    const x = Math.floor(x0 - margin), y = Math.floor(y0 - margin);
    return [x, y, Math.ceil(x1 + margin) - x, Math.ceil(y1 + margin) - y];
}

function picture(ops, keep, box) {
    keep = chooser(keep);
    const kept = [];
    for (const op of ops) {
        // A group that holds nothing of these layers goes.
        if (op.k === "end" && kept.length && kept[kept.length - 1].k === "g") kept.pop();
        else if ((op.k !== "path" && op.k !== "radial") || keep(op)) kept.push(op);
    }
    return WizRig.toSVG(kept, null, box || bounds(ops, keep, 1.5)) + "\n";
}

// One of the shell's layers around `centre`, scaled and turned about it.
function part(name, centre, scale = 1, turn = 0) {
    const L = WizRig.LAYERS[name], at = L.at || [0, 0], b = L.box;
    const ops = [{ k: "g", t: [["t", centre[0], centre[1]], ["r", turn, 0, 0], ["s", scale, scale], ["t", -at[0], -at[1]]], a: 1 }]
        .concat(WizRig.layerOps(name), [{ k: "end" }]);
    return WizRig.toSVG(ops, null, [centre[0] + b[0] * scale, centre[1] + b[1] * scale, b[2] * scale, b[3] * scale]) + "\n";
}

// Brewing's moving parts in the still's frame: where each bubble starts on the
// brew, how far it rises (15 of the cauldron's units) and how long one of the
// cauldron's units is, for the bubbles' wobble.
function brew(ops) {
    const start = BUBBLES.map(b => placed(ops, "pot", [b.x, b.y]));
    const top = placed(ops, "pot", [BUBBLES[0].x, BUBBLES[0].y - 15]);
    const side = placed(ops, "pot", [BUBBLES[0].x + 1, BUBBLES[0].y]);
    return { start, rise: Math.hypot(top[0] - start[0][0], top[1] - start[0][1]),
        unit: Math.hypot(side[0] - start[0][0], side[1] - start[0][1]) };
}

function kiosk() {
    const files = {};
    for (const state of KIOSK_POSES) {
        const ops = WizRig.stillOps(state), add = (name, svg) => { files[`${state}-${name}.svg`] = svg; };
        if (state === "brewing") {
            // The stirring hand with its wand, and the bubbles, move on their own.
            const stirs = rightHand(ops), apart = ["bubble", "wand", "wand-tip"];
            add("body", picture(ops, op => BODY.includes(op.layer) && !apart.includes(op.layer) && !stirs.has(op)));
        } else add("body", picture(ops, BODY));
        add("hat", picture(STAR_APART.includes(state) ? WizRig.stillOps(state, { light: "rest" }) : ops, HAT));
        if (STAR_APART.includes(state))
            add("star", picture(ops, ["star"]));
        // The blink's frames share the open eyes' box; the glow needs room.
        const eyes = bounds(ops, ["eyes"], 5), open = WizRig.POSES[state].eyeOpen;
        add("eyes", picture(ops, EYES, eyes));
        if (state !== "happy") {
            add("eyes-half", picture(WizRig.stillOps(state, { patch: { eyeOpen: open * 0.45 } }), EYES, eyes));
            add("eyes-shut", picture(WizRig.stillOps(state, { patch: { eyeOpen: open * 0.08 } }), EYES, eyes));
        }
        if (state === "thinking") {
            const orbit = placed(ops, "brim", [WizRig.LAYOUT.orbit.cx, WizRig.LAYOUT.orbit.cy]);
            for (let q = 0; q < 4; q++)
                add(`rune${q}`, part(`rune${q}`, orbit));
        } else if (state === "brewing") {
            // One turn of the stir in drawn steps: his hand goes round and
            // the wand sweeps through the brew.
            const P = WizRig.POSES.brewing;
            for (let i = 0; i < STIR.steps; i++) {
                const a = 2 * Math.PI * i / STIR.steps;
                const turn = WizRig.stillOps(state, { patch: { rx: P.rx + Math.cos(a) * STIR.rx, ry: P.ry + Math.sin(a) * STIR.ry,
                    wandA: P.wandA - Math.cos(a) * STIR.wandA } });
                const stirs = rightHand(turn);
                add(`stir${i}`, picture(turn, op => op.layer === "wand" || op.layer === "wand-tip" || stirs.has(op)));
            }
            // Each bubble at the start of its rise, at its own size: the
            // shell's bubble layer is the first and smallest.
            const at = brew(ops);
            BUBBLES.forEach((b, j) => add(`bubble${j}`, part("bubble", at.start[j], b.r / BUBBLES[0].r)));
        } else if (state === "happy") {
            // A finished installation's sparkles, each at its own size.
            WizRig.LAYOUT.sparks.forEach((spark, z) =>
                add(`sparkle${z}`, part("sparkle", placed(ops, "body", spark), spark[3])));
        }
    }
    return files;
}

// Each output directory and the files it holds.
function expected() {
    const layers = {}, stills = {};
    for (const name of Object.keys(WizRig.LAYERS))
        layers[`${name}.svg`] = WizRig.layerSVG(name);
    for (const state of WizRig.STATES.filter(state => state !== "carried"))
        stills[`${state}.svg`] = WizRig.stillSVG(state);
    return { "desktop/quickshell/assets/wiz": layers, "assets/wiz": stills, "installer/kiosk/assets/wiz": kiosk() };
}

function present(dir) {
    return fs.existsSync(dir) ? fs.readdirSync(dir).filter(name => name.endsWith(".svg")) : [];
}

function main(argv) {
    const outputs = expected();
    if (argv.length && argv[0] !== "--check" || argv.length > 1) {
        console.error("usage: scripts/export-wiz [--check]");
        return 2;
    }
    let differs = 0;
    for (const [rel, files] of Object.entries(outputs)) {
        const dir = path.join(root, rel);
        const stale = present(dir).filter(name => !(name in files));
        if (argv[0] === "--check") {
            const changed = Object.keys(files).filter(name => {
                const file = path.join(dir, name);
                return !fs.existsSync(file) || fs.readFileSync(file, "utf8") !== files[name];
            });
            for (const name of [...changed, ...stale])
                console.error(`${rel}/${name} is out of date; run scripts/export-wiz`);
            differs += changed.length + stale.length;
            continue;
        }
        fs.mkdirSync(dir, { recursive: true });
        for (const [name, svg] of Object.entries(files))
            fs.writeFileSync(path.join(dir, name), svg);
        for (const name of stale)
            fs.unlinkSync(path.join(dir, name));
    }
    return differs ? 1 : 0;
}

// The installer's test reads where its moving parts go.
if (require.main === module) process.exitCode = main(process.argv.slice(2));
else module.exports = { brew, placed, STIR, BUBBLES, KIOSK_POSES };
