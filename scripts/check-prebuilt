#!/usr/bin/env python3
"""List what a Cybex OS system would compile instead of downloading.

Walks the system's derivation graph from its root, asking cache.nixos.org for
every output a derivation's users need (a package's `out`, `dev`, `lib`, ...),
independent of what this computer's store already holds. A derivation whose
needed outputs are all cached covers its whole subtree; one with a needed
output missing is built, and so are its own inputs' missing outputs. What
remains is a fresh machine's build plan, judged as the updater judges it (`prebuilt.compiles`):
configuration files (local-only by design), fixed-output downloads and the
system's expected local builds (`system.build.cybexosExpectedBuilds`: Cybex
OS's own packages and their declared parts, unfree vendor downloads, kernel
modules) are allowed. What those builds need is checked too; only
`cybexos.updates.expectedBuilds` covers what it needs
(`system.build.cybexosDeclaredBuilds`). Anything else is a Nixpkgs package
that NixOS has not prebuilt, or a configuration that changed one; the command
lists those and exits 1.

Settings' pointer themes are downloaded later, on demand, from the same cache
(`system.build.cybexosPointerDownloads`); a path it does not hold is listed as
`pointer theme: PATH` and fails the check too.

NixOS generates much of a system's configuration (pam.d, the initrd, setuid
wrappers, dconf and AppArmor rules) without marking it local-only. Such a
derivation has no source of its own (`src`/`srcs`; `prebuilt.kind`): it is
listed on stderr as configuration, and its inputs are still checked, so a
package it would compile is still reported.

    scripts/check-prebuilt                       # the default product system
    scripts/check-prebuilt --nvidia              # with NVIDIA drivers
    scripts/check-prebuilt --catalogue           # plus every Software profile app
    scripts/check-prebuilt --xps                 # the XPS stack (checks.xps-system)
    scripts/check-prebuilt --profile ID          # an approved hardware profile
"""
import argparse
import http.client
import json
import subprocess
import sys
import time
import urllib.error
import urllib.request
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / 'lifecycle'))
from cybexos.prebuilt import compiles, derivation_graph, kind, name  # noqa: E402

NIX = ['nix', '--extra-experimental-features', 'nix-command flakes']


def nix(*arguments):
    """Nix's stdout; on failure, exit with Nix's own error message."""
    result = subprocess.run(NIX + list(arguments), capture_output=True, text=True)
    if result.returncode:
        sys.exit(result.stderr.strip() or 'nix ' + arguments[0] + ' failed')
    return result.stdout


def evaluate(nvidia, packages, profile=None, xps=False, hardware=None):
    expression = '''
      let
        flake = builtins.getFlake (toString %(root)s);
        system = flake.inputs.nixpkgs.lib.nixosSystem {
          system = "x86_64-linux";
          modules = [ flake.nixosModules.default (%(root)s + "/nix/tests/machine.nix") ({ lib, ... }: {
            cybexos.features = { proprietary = lib.mkForce true; steam = lib.mkForce true; docker = lib.mkForce true; };
            cybexos.hardware.nvidia = %(nvidia)s;
            cybexos.hardware.profile = builtins.fromJSON %(profile)s;
            cybexos.software.packages = builtins.fromJSON %(packages)s;
          }) { cybexos.hardware = builtins.fromJSON %(hardware)s; } ]
            ++ (if %(xps)s then [ { cybexos.hardware.xps = { enable = true; sku = "0DB9"; camera = false; }; } ] else [ ]);
        };
      in { root = system.config.system.build.toplevel.drvPath;
           expected = system.config.system.build.cybexosExpectedBuilds;
           vendor = system.config.system.build.cybexosVendorBuilds;
           declared = system.config.system.build.cybexosDeclaredBuilds;
           pointers = system.config.system.build.cybexosPointerDownloads; }
    ''' % {'root': json.dumps(str(ROOT)), 'nvidia': 'true' if nvidia else 'false',
           'packages': json.dumps(json.dumps(packages)), 'profile': json.dumps(json.dumps(profile)),
           'xps': 'true' if xps else 'false', 'hardware': json.dumps(json.dumps(hardware or {}))}
    return json.loads(nix('eval', '--impure', '--json', '--expr', expression))


CACHE = 'https://cache.nixos.org'
ATTEMPTS = 4


def cached(path):
    """Whether cache.nixos.org holds a store path. 404 is a definite no.

    A timeout, reset connection, rate limit or server error is tried again
    with backoff before it fails the check: one transient 503 should not
    cost a full check its run.
    """
    digest = Path(path).name.split('-', 1)[0]
    request = urllib.request.Request(f'{CACHE}/{digest}.narinfo', method='HEAD')
    for attempt in range(ATTEMPTS):
        try:
            with urllib.request.urlopen(request, timeout=30):
                return True
        except urllib.error.HTTPError as error:
            if error.code == 404:
                return False
            if (error.code < 500 and error.code != 429) or attempt == ATTEMPTS - 1:
                raise
        except (urllib.error.URLError, http.client.HTTPException, OSError):
            if attempt == ATTEMPTS - 1:
                raise
        time.sleep(2 ** attempt)


def requested(value, info):
    """The outputs of an input derivation its user needs; all of them when Nix doesn't say."""
    outputs = value.get('outputs') if isinstance(value, dict) else value
    if isinstance(outputs, list) and outputs and all(isinstance(output, str) for output in outputs):
        return set(outputs)
    return set(info['outputs'])


def plan(graph, root, check, pool):
    """The derivations a fresh machine builds: those with a needed output no cache holds.

    A derivation is checked again when another user needs a further output
    of it, so a cached `out` cannot hide a missing `dev` another package needs.
    """
    needed, missing, known = {}, set(), {}
    pending = {root: set(graph[root]['outputs'])}
    while pending:
        work = {}
        for drv, outputs in pending.items():
            new = set() if drv in missing else outputs - needed.get(drv, set())
            if new:
                needed.setdefault(drv, set()).update(new)
                work[drv] = new
        paths = {(drv, output): (graph[drv]['outputs'].get(output) or {}).get('path')
                 for drv, outputs in work.items() for output in outputs}
        unknown = [path for path in dict.fromkeys(paths.values()) if path and path not in known]
        known.update(zip(unknown, pool.map(check, unknown)))
        pending = {}
        for drv, outputs in work.items():
            if all(paths[drv, output] and known[paths[drv, output]] for output in outputs):
                continue
            missing.add(drv)
            for dependency, value in (graph[drv].get('inputDrvs') or {}).items():
                pending.setdefault(dependency, set()).update(requested(value, graph[dependency]))
    return missing


def walk(root, expected, vendor, declared):
    graph = derivation_graph(json.loads(nix('derivation', 'show', '-r', root)))
    with ThreadPoolExecutor(32) as pool:
        missing = plan(graph, root, cached, pool)
    builds = {drv: graph[drv] for drv in missing}
    found = compiles(lambda *arguments, **options: json.dumps({d: builds[d] for d in arguments[3:]}),
                     sorted(missing), root=root, expected=expected, vendor=vendor, declared=declared)
    # Configuration a declared build needs is part of that build.
    covered, frontier = set(), [d for d in declared if d in missing and d not in vendor]
    while frontier:
        drv = frontier.pop()
        if drv not in covered:
            covered.add(drv)
            frontier.extend(d for d in graph[drv].get('inputDrvs') or {} if d in missing)
    configured = sorted({name(d) for d in missing - covered if kind(graph[d]) == 'configuration'})
    return found, configured, len(missing)


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument('--nvidia', action='store_true', help='include NVIDIA drivers')
    parser.add_argument('--catalogue', action='store_true', help='add every Software profile app')
    parser.add_argument('--profile', metavar='ID', help='an approved hardware profile (lifecycle/cybexos/hardware-profiles.json)')
    parser.add_argument('--xps', action='store_true', help='the XPS stack, as checks.xps-system builds it')
    arguments = parser.parse_args()
    packages = []
    if arguments.catalogue:
        catalogue = json.loads((ROOT / 'desktop/software/catalogue.json').read_text())
        apps = {app['id']: app for app in catalogue['apps']}
        packages = sorted({apps[i]['attribute'] for p in catalogue['profiles'] for i in p['apps']})
    hardware = {}
    if arguments.profile:
        # What the installer sets with the profile: a profile alone doesn't
        # enable the XPS or ZBook stacks it was written for.
        catalogue = json.loads((ROOT / 'lifecycle/cybexos/hardware-profiles.json').read_text())
        found = next((p for p in catalogue['profiles'] if p['id'] == arguments.profile and p.get('approved')), None)
        if not found:
            sys.exit(f'{arguments.profile} is not an approved hardware profile')
        hardware = (found.get('configuration') or {}).get('existingOptions') or {}
    info = evaluate(arguments.nvidia, packages, arguments.profile, arguments.xps, hardware)
    found, configured, local = walk(info['root'], info['expected'], info['vendor'], info['declared'])
    print(f'{local} derivations build locally; {len(info["expected"])} expected local builds allowed.', file=sys.stderr)
    if configured:
        print(f'{len(configured)} configuration builds: ' + ', '.join(configured), file=sys.stderr)
    with ThreadPoolExecutor(8) as pool:
        missing = [path for path, hit in zip(info['pointers'], pool.map(cached, info['pointers'])) if not hit]
    print(f'{len(info["pointers"])} pointer theme downloads checked.', file=sys.stderr)
    for item in found + ['pointer theme: ' + path for path in missing]:
        print(item)
    return 1 if found or missing else 0


if __name__ == '__main__':
    sys.exit(main())
