+    /// Records how often, and on how much audio, it was asked to transcribe.
+    struct SlowTranscriber {
+        calls: std::sync::Mutex<Vec<usize>>,
+    }
+
+    impl Transcriber for SlowTranscriber {
+        fn transcribe(&self, samples: &[f32]) -> Result<String, TranscribeError> {
+            std::thread::sleep(Duration::from_millis(150));
+            self.calls.lock().unwrap().push(samples.len());
+            Ok("alpha beta gamma delta".to_string())
+        }
+    }
+
+    #[tokio::test]
+    async fn a_recording_that_never_slid_ends_with_its_whole_transcript() {
+        let events = run_session(streaming_config()).await;
+        let whole: Vec<&str> = events
+            .iter()
+            .filter_map(|ev| match ev {
+                StreamingEvent::Whole { text } => Some(text.as_str()),
+                _ => None,
+            })
+            .collect();
+        assert_eq!(whole, vec!["alpha beta gamma delta"]);
+        assert!(matches!(events.last(), Some(StreamingEvent::Ended)));
+        assert!(matches!(events[events.len() - 2], StreamingEvent::Whole { .. }));
+    }
+
+    #[test]
+    fn a_slid_buffer_has_no_whole_transcript() {
+        let mut session = Session::new(Arc::new(FakeTranscriber), streaming_config());
+        session.feed(&loud_samples(3.0));
+        session.sliding = true;
+        session.final_flush();
+        assert_eq!(session.whole_transcript, None);
+    }
+
+    #[tokio::test]
+    async fn queued_audio_is_taken_in_before_a_tick_and_flushed_whole() {
+        let slow = Arc::new(SlowTranscriber {
+            calls: Default::default(),
+        });
+        let transcriber: Arc<dyn Transcriber> = slow.clone();
+        let engine = SlidingWindowStreamingTranscriber::new(transcriber, streaming_config());
+        let (tx, rx) = mpsc::channel::<Vec<f32>>(1024);
+        // Three seconds in 10 ms chunks, queued as they would be behind a
+        // slow inference, then the end of the recording.
+        for _ in 0..300 {
+            tx.send(loud_samples(0.01)).await.unwrap();
+        }
+        let mut handle = engine.start_stream(rx).expect("start stream");
+        drop(tx);
+        while let Some(ev) = handle.events.recv().await {
+            if matches!(ev, StreamingEvent::Ended) {
+                break;
+            }
+        }
+        handle.task.await.unwrap().expect("task ok");
+        let calls = slow.calls.lock().unwrap().clone();
+        assert_eq!(calls.last().copied(), Some(48_000), "the flush hears everything: {calls:?}");
+        assert!(calls.len() <= 2, "no tick per queued chunk: {calls:?}");
+    }
