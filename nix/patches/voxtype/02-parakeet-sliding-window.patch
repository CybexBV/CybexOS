+/// Whether a streamed Parakeet session uses the sliding window over the
+/// batch model: a known model without the cache-aware streaming files.
+#[cfg(feature = "parakeet")]
+fn parakeet_streams_by_window(model: &str) -> bool {
+    let name = std::path::Path::new(model)
+        .file_name()
+        .and_then(|n| n.to_str())
+        .unwrap_or(model);
+    crate::setup::model::is_known_parakeet_model(name)
+        && !crate::setup::model::is_streaming_compatible_parakeet(name)
+}
