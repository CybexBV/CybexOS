+/// Path of the live preview for a streamed transcript.
+///
+/// A file-output streaming session types nothing while it runs, so this
+/// sibling carries the running text (committed segments plus the current
+/// partial) for a client that draws its own dictation UI.
+pub fn live_preview_path(transcript: &std::path::Path) -> std::path::PathBuf {
+    let mut live = transcript.as_os_str().to_os_string();
+    live.push(".live");
+    std::path::PathBuf::from(live)
+}
+
+/// Replace the live preview atomically, so a reader never sees half a write.
+fn write_live_preview(transcript: &std::path::Path, text: &str) {
+    let live = live_preview_path(transcript);
+    let staged = temp_sibling(&live);
+    if std::fs::write(&staged, text).is_err() {
+        let _ = std::fs::remove_file(&staged);
+        return;
+    }
+    if std::fs::rename(&staged, &live).is_err() {
+        let _ = std::fs::remove_file(&staged);
+    }
+}
+
+/// Path of a file-output session's recording: 16-bit mono WAV beside the
+/// transcript, for a client that keeps its dictations (Cybex OS).
+pub fn recording_path(transcript: &std::path::Path) -> std::path::PathBuf {
+    let mut wav = transcript.as_os_str().to_os_string();
+    wav.push(".wav");
+    std::path::PathBuf::from(wav)
+}
+
+/// Write a file-output session's audio beside its transcript, atomically,
+/// before the outcome is published. A failure only loses the recording.
+fn write_recording(transcript: &std::path::Path, samples: &[f32], sample_rate: u32) {
+    let target = recording_path(transcript);
+    let staged = temp_sibling(&target);
+    let spec = hound::WavSpec {
+        channels: 1,
+        sample_rate,
+        bits_per_sample: 16,
+        sample_format: hound::SampleFormat::Int,
+    };
+    let written = (|| -> std::result::Result<(), hound::Error> {
+        let mut writer = hound::WavWriter::create(&staged, spec)?;
+        for sample in samples {
+            writer.write_sample((sample.clamp(-1.0, 1.0) * i16::MAX as f32) as i16)?;
+        }
+        writer.finalize()
+    })();
+    if written.is_err() || std::fs::rename(&staged, &target).is_err() {
+        tracing::warn!("Could not keep the recording beside {:?}", transcript);
+        let _ = std::fs::remove_file(&staged);
+    }
+}
+
+/// Publish a file-output streaming session's running text.
+fn publish_live_preview(state: &State, session: &StreamingSession) {
+    if let State::Streaming {
+        file_output_path: Some(path),
+        ..
+    } = state
+    {
+        let mut text = session.finalized_text().to_string();
+        text.push_str(session.partial());
+        write_live_preview(path, &text);
+    }
+}
