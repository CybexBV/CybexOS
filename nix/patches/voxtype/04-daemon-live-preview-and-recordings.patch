+
+    #[test]
+    fn recording_is_kept_beside_the_transcript() {
+        let dir = TempDir::new().unwrap();
+        let transcript = dir.path().join("dictation.txt");
+        write_recording(&transcript, &[0.0, 0.5, -0.5, 1.5], 16000);
+        let reader = hound::WavReader::open(recording_path(&transcript)).unwrap();
+        assert_eq!(reader.spec().sample_rate, 16000);
+        assert_eq!(reader.spec().channels, 1);
+        let samples: Vec<i16> = reader.into_samples::<i16>().map(|s| s.unwrap()).collect();
+        assert_eq!(samples, vec![0, 16383, -16383, i16::MAX]);
+    }
+
+    #[test]
+    fn live_preview_is_replaced_whole() {
+        let dir = TempDir::new().unwrap();
+        let transcript = dir.path().join("dictation.txt");
+        write_live_preview(&transcript, "hello");
+        write_live_preview(&transcript, "hello world");
+        assert_eq!(
+            fs::read_to_string(live_preview_path(&transcript)).unwrap(),
+            "hello world"
+        );
+        let names: Vec<_> = fs::read_dir(dir.path())
+            .unwrap()
+            .map(|e| e.unwrap().file_name().to_string_lossy().into_owned())
+            .collect();
+        assert_eq!(names, vec!["dictation.txt.live".to_string()], "no staged file is left");
+    }
