import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Store, StageRow } from "../store.slint";
import { Kicker, Heading, Lead, Btn, Card, Mark } from "../widgets.slint";
import { Wiz } from "../wiz.slint";

// ── installing ───────────────────────────────────────────────────────────────

component StageLine inherits Rectangle {
    in property <StageRow> data;
    in property <int> number;
    in property <bool> first;
    height: root.data.state == 1 && root.data.detail != "" ? 74px : 54px;
    if !root.first: Rectangle {
        y: 0;
        height: 1px;
        background: Theme.line;
    }
    Mark {
        x: 0;
        state: root.data.state == 0 ? 0 : root.data.state == 1 ? 1 : 2;
        tick: Store.tick;
    }
    VerticalLayout {
        x: 40px;
        width: parent.width - 70px;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.data.title;
            font-size: 17px;
            font-weight: root.data.state == 1 ? 700 : 400;
            color: root.data.state == 1 ? Theme.ink : root.data.state == 0 ? Theme.fog : Theme.faint;
            overflow: elide;
        }
        if root.data.state == 1 && root.data.detail != "": Text {
            text: root.data.detail;
            font-size: 13.5px;
            color: Theme.fog;
            overflow: elide;
        }
    }
    Text {
        x: parent.width - 20px;
        text: root.number;
        font-family: Theme.mono;
        font-size: 12px;
        color: Theme.faint;
        vertical-alignment: center;
        height: parent.height;
    }
}

export component InstallingScreen inherits Rectangle {
    width: 1280px;
    height: 800px;
    VerticalLayout {
        x: 64px;
        y: 128px;
        width: 560px;
        alignment: start;
        Kicker {
            text: "INSTALLING · STEP " + max(1, Store.stage) + " OF " + Store.stage-count;
            color: Theme.accent;
        }
        Rectangle { height: 14px; }
        Heading { text: "Your desktop is\non its way."; }
        Rectangle { height: 14px; }
        Lead { text: "Keep the power and internet connected. It finishes on its own, so you can step away."; }
        Rectangle { height: 26px; }
        HorizontalLayout {
            height: 6px;
            spacing: 6px;
            for index in Store.stage-count: Rectangle {
                border-radius: 3px;
                background: index + 1 < Store.stage ? Theme.accent : index + 1 == Store.stage ? #60a5fa73 : Theme.line-2;
            }
        }
        Rectangle { height: 10px; }
        Text {
            text: "Elapsed " + Store.elapsed;
            font-family: Theme.mono;
            font-size: 14px;
            color: Theme.fog;
        }
        Rectangle { height: 26px; }
        Card {
            height: tip.preferred-height;
            tip := VerticalLayout {
                padding: 22px;
                spacing: 10px;
                Kicker { text: "WHILE YOU WAIT"; }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    height: 36px;
                    for key[i] in Store.tip-keys: HorizontalLayout {
                        spacing: 6px;
                        if i > 0: Text {
                            text: "+";
                            color: Theme.faint;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            width: key-label.preferred-width + 22px;
                            border-radius: 8px;
                            background: Theme.bg-deep;
                            border-width: 1px;
                            border-color: Theme.line-2;
                            key-label := Text {
                                text: key;
                                font-family: Theme.mono;
                                font-weight: 700;
                                font-size: 15px;
                                color: Theme.ink;
                            }
                        }
                    }
                }
                Text {
                    text: Store.tip-text;
                    font-size: 16px;
                    color: Theme.fog;
                    wrap: word-wrap;
                }
            }
        }
        Rectangle { height: 22px; }
        HorizontalLayout {
            alignment: start;
            Btn {
                small: true;
                icon: Icons.log;
                text: "Show installation details";
                clicked => { Store.open-sheet("log"); }
            }
        }
    }
    stage-card := Card {
        x: 680px;
        y: 206px;
        width: 536px;
        height: steps.preferred-height + 12px;
        steps := VerticalLayout {
            x: 26px;
            y: 6px;
            width: parent.width - 52px;
            alignment: start;
            for stage[i] in Store.stages: StageLine {
                data: stage;
                number: i + 1;
                first: i == 0;
            }
        }
    }
    Wiz {
        x: 1126px - self.width / 2;
        y: stage-card.y - self.feet;
        pose: Store.install-pose;
    }
}
